# --- Network -------------------------------------------------------------
# LAN IP of this machine (NOT localhost). Xray containers use it to reach Artifactory.
HOST_IP=192.168.1.10

# --- Artifactory ---------------------------------------------------------
# Pin real tags from https://releases-docker.jfrog.io (Artifactory + Xray must be compatible)
ARTIFACTORY_VERSION=latest
POSTGRES_VERSION=15
DB_PASSWORD=change-me
JOIN_KEY=change-me
JF_ADMIN_USER=admin
JF_ADMIN_PASSWORD=password   # change after first login, then update here

# --- Xray ----------------------------------------------------------------
# Version of the official Xray docker-compose installer, e.g. 3.x.y
XRAY_VERSION=
